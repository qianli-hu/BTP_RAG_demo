# Copy to .env and fill in. NEVER commit .env.

# --- Provider selection ---
EMBEDDING_PROVIDER=openai        # openai | sap_genaihub | local
LLM_PROVIDER=openai              # openai | sap_genaihub | local

# --- OpenAI v1 model provider ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
ANSWER_MODEL=gpt-5.4-mini
JUDGE_MODEL=gpt-5.5              # use a stronger/different judge than the answer model

# --- SAP AI Core / Generative AI Hub (future provider; from service key) ---
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default
SAP_EMBEDDING_MODEL=text-embedding-3-small
SAP_EMBEDDING_DIM=1536           # keep parity with v1; changing model/dim requires full re-embed
SAP_CHAT_MODEL=anthropic--claude-3.6-sonnet

# --- HANA Cloud (vector store) ---
HANA_HOST=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=

# --- App ---
TOP_K=5
SIM_THRESHOLD=0.30        # initial guess only; calibrate on gold/adversarial eval
NOT_IN_KB=Not in knowledge base.
