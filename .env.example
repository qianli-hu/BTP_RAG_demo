# Copy to .env and fill in. NEVER commit .env.

# --- SAP AI Core / Generative AI Hub (from the service key) ---
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default

# --- Model deployment IDs / names (set after deploying in Gen AI Hub) ---
EMBEDDING_MODEL=text-embedding-3-large
CHAT_MODEL=anthropic--claude-3.6-sonnet     # adjust to enabled model name

# --- HANA Cloud (vector store) ---
HANA_HOST=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=

# --- App ---
TOP_K=5
SIM_THRESHOLD=0.30        # below this -> "not in knowledge base"
